<Window x:Class="CleanerPro.App.Dialogs.TextViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="640" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}" FontSize="{DynamicResource FontSize.Body}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="_Copy to clipboard" Click="OnCopy" />
      <Button Content="_Close" IsCancel="True" IsDefault="True" Click="OnClose" Style="{StaticResource Button.Primary}" Margin="0" />
    </StackPanel>
    <TextBox x:Name="Body" Style="{StaticResource TextBox.Code}" AutomationProperties.Name="Text content" />
  </DockPanel>
</Window>
