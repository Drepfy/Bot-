<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light palette. Text/background pairs meet WCAG 2.1 AA contrast (4.5:1). -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F7F8FA" />
  <SolidColorBrush x:Key="Brush.Border" Color="#D1D5DB" />
  <SolidColorBrush x:Key="Brush.Text" Color="#111827" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#4B5563" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#0F6CBD" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#115EA3" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0C3B5E" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#B91C1C" />
  <SolidColorBrush x:Key="Brush.DangerHover" Color="#991B1B" />
  <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#92400E" />
  <SolidColorBrush x:Key="Brush.Success" Color="#166534" />
  <SolidColorBrush x:Key="Brush.Info" Color="#1E40AF" />
  <SolidColorBrush x:Key="Brush.Nav" Color="#E5E7EB" />
  <SolidColorBrush x:Key="Brush.NavSelected" Color="#DBEAFE" />
  <SolidColorBrush x:Key="Brush.NavSelectedText" Color="#0C3B5E" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#000000" />
  <SolidColorBrush x:Key="Brush.Hover" Color="#E5E7EB" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#D1D5DB" />
  <SolidColorBrush x:Key="Brush.ButtonBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Disabled" Color="#9CA3AF" />
  <SolidColorBrush x:Key="Brush.Banner" Color="#FEF3C7" />
  <SolidColorBrush x:Key="Brush.BannerText" Color="#78350F" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#BFDBFE" />
  <SolidColorBrush x:Key="Brush.Class.Known" Color="#B91C1C" />
  <SolidColorBrush x:Key="Brush.Class.High" Color="#B45309" />
  <SolidColorBrush x:Key="Brush.Class.Review" Color="#1D4ED8" />
  <SolidColorBrush x:Key="Brush.Class.Legit" Color="#166534" />
  <SolidColorBrush x:Key="Brush.Class.Unverified" Color="#4B5563" />
</ResourceDictionary>
