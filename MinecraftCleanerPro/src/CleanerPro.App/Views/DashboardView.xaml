<UserControl x:Class="CleanerPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CleanerPro.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Space.Page}">

      <ItemsControl ItemsSource="{Binding Notices}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Banner}">
              <controls:PrivateText Value="{Binding Mode=OneWay}" Style="{StaticResource Text.Banner}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Open _Scanner" Style="{StaticResource Button.Primary}" Command="{Binding GoToScannerCommand}"
                    ToolTip="Choose Quick, Full or Custom scan and review the scope before starting." />
            <Button Content="View _Findings" Command="{Binding GoToFindingsCommand}" Margin="0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Last completed scan" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding LastScanText, Mode=OneWay}" Style="{StaticResource Text.Subtitle}" Margin="0" />
            <TextBlock Text="{Binding InstallationsSummary, Mode=OneWay}" Style="{StaticResource Text.Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <UniformGrid Columns="4" Margin="0,0,-12,0">
        <UniformGrid.Resources>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
          </Style>
        </UniformGrid.Resources>
        <Border ToolTip="Files of inspectable types that were opened and checked in the last scan.">
          <StackPanel>
            <TextBlock Text="Files inspected" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding FilesInspected, Mode=OneWay}" Style="{StaticResource Text.StatValue}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Unique files or folders flagged; a file matched by several rules counts once.">
          <StackPanel>
            <TextBlock Text="Unique detections" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding UniqueDetections, Mode=OneWay}" Style="{StaticResource Text.StatValue}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Items classified as 'Known match': a validated indicator matched a documented rule.">
          <StackPanel>
            <TextBlock Text="Confirmed matches" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding ConfirmedMatches, Mode=OneWay}" Style="{StaticResource Text.StatValue}" Foreground="{DynamicResource Brush.Class.Known}" />
          </StackPanel>
        </Border>
        <Border ToolTip="High-confidence suspicions, items that need review and unverified items.">
          <StackPanel>
            <TextBlock Text="Suspicious / review" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding SuspiciousFiles, Mode=OneWay}" Style="{StaticResource Text.StatValue}" Foreground="{DynamicResource Brush.Class.High}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Files currently held in quarantine (restorable).">
          <StackPanel>
            <TextBlock Text="Quarantined files" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding QuarantinedFiles, Mode=OneWay}" Style="{StaticResource Text.StatValue}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Findings confirmed as no longer present by a post-cleanup verification scan.">
          <StackPanel>
            <TextBlock Text="Verified removals" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding VerifiedRemovals, Mode=OneWay}" Style="{StaticResource Text.StatValue}" Foreground="{DynamicResource Brush.Class.Legit}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Files that could not be inspected (too large, access denied, changed during the scan...).">
          <StackPanel>
            <TextBlock Text="Skipped files" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding SkippedFiles, Mode=OneWay}" Style="{StaticResource Text.StatValue}" />
          </StackPanel>
        </Border>
        <Border ToolTip="Version of the detection rule database in use.">
          <StackPanel>
            <TextBlock Text="Rule database" Style="{StaticResource Text.Muted}" />
            <TextBlock Text="{Binding DatabaseVersion, Mode=OneWay}" Style="{StaticResource Text.StatValue}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Protection status" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="{Binding RulesSource, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="{StaticResource Space.GapSmall}" />
          <TextBlock Text="{Binding NetworkSummary, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="{StaticResource Space.GapSmall}" />
          <TextBlock Style="{StaticResource Text.Muted}"
                     Text="File scanning finds installed cheat clients, their leftovers and documented Minecraft malware. It cannot prove whether someone cheated: some cheats leave no files. See About &amp; Limitations." />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="_Installations" Command="{Binding GoToInstallationsCommand}" />
            <Button Content="_Quarantine" Command="{Binding GoToQuarantineCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
