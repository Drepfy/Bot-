<UserControl x:Class="CleanerPro.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Space.Page}">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Privacy" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="{Binding Statement, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="{StaticResource Space.Gap}" />
          <TextBlock Text="{Binding OfflineStatus, Mode=OneWay}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Detection rule database" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="{Binding RulesStatus, Mode=OneWay}" Style="{StaticResource Text.Body}" />
          <TextBlock Text="{Binding RulesDetails, Mode=OneWay}" Style="{StaticResource Text.Small}" Margin="{StaticResource Space.GapSmall}" />
          <ItemsControl ItemsSource="{Binding RuleWarnings}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Banner}">
                  <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource Text.Banner}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding UpdateConfiguration, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="0,6,0,6" />
          <TextBlock Text="{Binding UpdateStatus, Mode=OneWay}" Style="{StaticResource Text.Muted}" Margin="{StaticResource Space.GapSmall}" />
          <StackPanel Orientation="Horizontal">
            <Button Content="_Check for signed rule update" Command="{Binding CheckUpdatesCommand}"
                    ToolTip="Only available when offline mode is off and a trusted HTTPS source and signing key are configured." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Clear _log…" Command="{Binding ClearNetworkLogCommand}" Margin="0" />
            <TextBlock Text="Network activity" Style="{StaticResource Text.Subtitle}" />
          </DockPanel>
          <TextBlock Text="No network requests have been made or attempted." Style="{StaticResource Text.Muted}"
                     Visibility="{Binding NoNetworkActivity, Converter={StaticResource BoolToVisibility}}" />
          <DataGrid ItemsSource="{Binding NetworkActivity}" MaxHeight="240" AutomationProperties.Name="Network activity"
                    Visibility="{Binding NoNetworkActivity, Converter={StaticResource BoolToVisibilityInverse}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" SortMemberPath="TimestampUtc" Width="Auto" />
              <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose, Mode=OneWay}" Width="Auto" />
              <DataGridCheckBoxColumn Header="Allowed" Binding="{Binding Allowed, Mode=OneWay}" Width="Auto" />
              <DataGridTextColumn Header="URL" Binding="{Binding Url, Mode=OneWay}" Width="2*" />
              <DataGridTextColumn Header="HTTP" Binding="{Binding StatusCode, Mode=OneWay}" Width="Auto" />
              <DataGridTextColumn Header="Details" Binding="{Binding Detail, Mode=OneWay}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Data stored on this computer" Style="{StaticResource Text.Subtitle}" />
          <ItemsControl ItemsSource="{Binding Locations}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="{StaticResource Space.GapSmall}">
                  <Button DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0"
                          Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Path}" AutomationProperties.Name="{Binding Name, Mode=OneWay, StringFormat='Open {0} folder'}" />
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Purpose, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Path, Mode=OneWay}" Style="{StaticResource Text.Small}" FontFamily="{StaticResource Font.Mono}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Delete scan _history…" Command="{Binding DeleteHistoryCommand}" />
            <Button Content="Delete saved _reports…" Command="{Binding DeleteReportsCommand}" />
            <Button Content="Clear scan _cache" Command="{Binding ClearCacheCommand}" ToolTip="Forget which unchanged files were already verified, so the next scan inspects everything again." />
            <Button Content="Re_fresh" Command="{Binding RefreshCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
