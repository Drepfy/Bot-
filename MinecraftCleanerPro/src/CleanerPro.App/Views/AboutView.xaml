<UserControl x:Class="CleanerPro.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource Space.Page}" MaxWidth="980" HorizontalAlignment="Left">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding Product, Mode=OneWay}" Style="{StaticResource Text.Subtitle}" />
          <TextBlock Text="{Binding Version, Mode=OneWay}" Style="{StaticResource Text.Body}" />
          <TextBlock Text="{Binding SigningNotice, Mode=OneWay}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Known limitations" Style="{StaticResource Text.Subtitle}" />
          <ItemsControl ItemsSource="{Binding Limitations}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="{StaticResource Space.GapSmall}">
                  <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource Text.Body}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource Text.Body}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Sources and credits" Style="{StaticResource Text.Subtitle}" />
          <ItemsControl ItemsSource="{Binding Credits}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="{StaticResource Space.GapSmall}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
